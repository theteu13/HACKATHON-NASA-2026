{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CosmoMedic: Preview dashboard",
            "type": "debugpy",
            "request": "launch",
            "python": "${env:USERPROFILE}/miniconda3/python.exe",
            "module": "http.server",
            "args": ["4173", "--bind", "127.0.0.1"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "redirectOutput": true,
            "justMyCode": false,
            "env": { "PYTHONUNBUFFERED": "1" },
            "serverReadyAction": {
                "pattern": "Serving HTTP on .* port ([0-9]+)",
                "uriFormat": "http://127.0.0.1:%s/index.html",
                "action": "openExternally"
            }
        },
        {
            "name": "CosmoMedic: Open in Edge",
            "type": "msedge",
            "request": "launch",
            "file": "${workspaceFolder}/index.html",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe",
            "userDataDir": "${env:TEMP}/CosmoMedic-debug-edge",
            "cleanUp": "wholeBrowser",
            "port": 0,
            "timeout": 30000
        },
        {
            "name": "CosmoMedic: Open in Chrome",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "C:/Program Files/Google/Chrome/Application/chrome.exe",
            "userDataDir": "${env:TEMP}/CosmoMedic-debug-chrome",
            "cleanUp": "wholeBrowser",
            "port": 0,
            "timeout": 30000
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
